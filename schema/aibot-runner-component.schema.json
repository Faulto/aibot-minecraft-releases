{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Faulto/aibot-minecraft-releases/blob/main/schema/aibot-runner-component.schema.json",
  "title": "AIBOT Minecraft gateway release descriptor",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "component_id": {
      "const": "minecraft_gateway"
    },
    "component_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "publisher": {
      "const": "Faulto/AIBOT-Minecraft"
    },
    "license_id": {
      "const": "LicenseRef-Proprietary"
    },
    "source_repository": {
      "const": "https://github.com/Faulto/aibot-minecraft"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "release_repository": {
      "const": "https://github.com/Faulto/aibot-minecraft-releases"
    },
    "image_repository": {
      "const": "ghcr.io/faulto/aibot-minecraft-gateway"
    },
    "artifact_digest": {
      "$ref": "#/$defs/digest"
    },
    "platform_sizes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linux/aarch64": {
          "type": "integer",
          "minimum": 1
        },
        "linux/x86_64": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["linux/aarch64", "linux/x86_64"]
    },
    "sbom_digest": {
      "$ref": "#/$defs/digest"
    },
    "provenance_digest": {
      "$ref": "#/$defs/digest"
    },
    "gateway_protocol": {
      "const": "0.1"
    },
    "gateway_contract_sha256": {
      "const": "2bc380dcd9eaa0c041e1c4574f1a709ab3a8969317e3942a4d4f80d81ab7cf6b"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  },
  "required": [
    "schema_version",
    "component_id",
    "component_version",
    "publisher",
    "license_id",
    "source_repository",
    "source_revision",
    "release_repository",
    "image_repository",
    "artifact_digest",
    "platform_sizes",
    "sbom_digest",
    "provenance_digest",
    "gateway_protocol",
    "gateway_contract_sha256",
    "release_tag",
    "published_at"
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
